src/rtmp/rtmp_session.i: src/rtmp/rtmp_session.cpp.i
.PHONY : src/rtmp/rtmp_session.i

# target to preprocess a source file
src/rtmp/rtmp_session.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/rtmp_abr_transcoder.dir/build.make CMakeFiles/rtmp_abr_transcoder.dir/src/rtmp/rtmp_session.cpp.i
.PHONY : src/rtmp/rtmp_session.cpp.i

src/rtmp/rtmp_session.s: src/rtmp/rtmp_session.cpp.s
.PHONY : src/rtmp/rtmp_session.s

# target to generate assembly for a file
